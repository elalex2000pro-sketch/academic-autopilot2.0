{
  "name": "academic-autopilot-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "App de escritorio de Academic Autopilot",
  "author": "Academic Autopilot",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:publish": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.academicautopilot.desktop",
    "productName": "Academic Autopilot",
    "copyright": "Copyright © 2026 Academic Autopilot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Academic-Autopilot-Setup.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Academic Autopilot",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elalex2000pro-sketch",
        "repo": "academic-autopilot2.0",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  }
}
