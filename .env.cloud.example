# =============================================================================
# Academic Autopilot - Variables de entorno para la NUBE (Google Cloud)
# Copiar a ".env" en la VM (nunca se sube al repositorio).
# =============================================================================

# --- General ---
ENVIRONMENT=production
# Generar con: openssl rand -hex 32  (crea una larga y aleatoria)
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# --- Base de datos (PostgreSQL dentro del stack) ---
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=cambia-esta-password-por-una-fuerte
POSTGRES_DB=academic_autopilot

# --- Imagenes (las construye GitHub Actions y las publica en ghcr.io) ---
# <usuario> debe ser tu usuario de GitHub en MINUSCULAS.
IMAGE_REGISTRY=ghcr.io/<tu-usuario-de-github>
IMAGE_TAG=latest

# --- Dominio y HTTPS (Caddy obtiene el certificado solo) ---
# Crea un subdominio gratis en https://www.duckdns.org  (ej. miacademia)
SITE_ADDRESS=miacademia.duckdns.org
CORS_ORIGINS=https://miacademia.duckdns.org
CORS_ORIGIN_REGEX=^https://miacademia\.duckdns\.org$

# --- IA (en la nube se usa Gemini; cada usuario pone su clave en Ajustes) ---
AI_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Google Classroom (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://miacademia.duckdns.org/settings

# --- Worker de sincronizacion ---
SYNC_INTERVAL_MINUTES=30

# --- Subida de archivos ---
MAX_UPLOAD_MB=25
