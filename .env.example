# =============================================================================
# Academic Autopilot - Variables de entorno (copiar a .env)
# =============================================================================

# --- General ---
ENVIRONMENT=development
# Clave secreta para firmar JWT. Generar con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=academic_autopilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena async para SQLAlchemy (asyncpg). Consumida por el backend.
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5432/academic_autopilot
# Cadena sync usada por Alembic en las migraciones (psycopg2).
DATABASE_URL_SYNC=postgresql+psycopg2://autopilot:autopilot@localhost:5432/academic_autopilot

# --- Backend ---
BACKEND_PORT=8000
# Origenes permitidos por CORS (separados por coma).
# Al publicar el frontend en Vercel anade aqui su dominio, p. ej.:
# CORS_ORIGINS=https://mi-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Regex adicional de origenes permitidos. Por defecto acepta cualquier origen
# http/https para que la app funcione en la LAN y por tuneles externos.
# Restringelo (p.ej. ^https://midominio\.com$) si expones la app publicamente.
# Para permitir cualquier despliegue de Vercel: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=^https?://.*$
# Sincronizacion en tiempo real (WebSocket) entre dispositivos.
REALTIME_ENABLED=true
# Proxy inverso (Caddy) que expone frontend + API en un unico origen.
PROXY_PORT=8080
# Solo despliegue en nube (docker-compose.prod.yml). Dominio del sitio: con un
# dominio real Caddy obtiene HTTPS automatico (Let's Encrypt) en 80/443.
# Dejalo vacio en local/LAN/tunel para seguir usando :8080 sin TLS.
SITE_ADDRESS=

# --- Worker de sincronizacion ---
SYNC_INTERVAL_MINUTES=30
ENABLE_SCHEDULER=true

# --- Moodle ---
# El token y la URL base se configuran por usuario desde la UI (Ajustes).
# Timeout en segundos para llamadas a la API de Moodle.
MOODLE_TIMEOUT_SECONDS=20

# --- Google Classroom (OAuth2) ---
# Crear credenciales OAuth2 (tipo "Aplicacion web") en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "URI de redireccionamiento autorizado" en
# Google Cloud Console. Apunta al frontend, que captura el ?code y lo envia al backend.
GOOGLE_REDIRECT_URI=http://localhost:3000/settings
# Scopes necesarios para leer cursos y tareas.
GOOGLE_CLASSROOM_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly,https://www.googleapis.com/auth/classroom.coursework.me.readonly

# --- Almacenamiento de archivos (documentos por asignatura) ---
# En Docker se guarda en el volumen `appfiles` montado en /data/files.
# En Render, monta un disco persistente en /data/files (si no, los archivos se
# pierden al redesplegar). En un servidor propio, la carpeta que prefieras.
FILES_DIR=/data/files
# Limite por archivo en MB. 20480 MB = 20 GB. Los archivos grandes se suben
# por trozos (subida reanudable), asi que ningun proxy corta la peticion.
MAX_UPLOAD_MB=20480
# Tamano de cada trozo de subida (MB) y horas antes de limpiar subidas a medias.
UPLOAD_CHUNK_MB=25
UPLOAD_SESSION_TTL_HOURS=48
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,md,csv,png,jpg,jpeg,gif

# --- Asistente de IA (API compatible con OpenAI; por defecto Ollama local) ---
AI_ENABLED=true
# Ollama expone una API compatible con OpenAI en /v1.
# Desde el contenedor, el host se alcanza con host.docker.internal.
AI_BASE_URL=http://host.docker.internal:11434/v1
# Ollama no requiere clave; para OpenAI/Groq/OpenRouter pega aqui tu API key.
AI_API_KEY=
# Modelo: debe estar descargado en Ollama, p.ej. `ollama pull llama3.1`.
# Para que la IA pueda controlar la app (crear/editar) conviene un modelo con
# soporte de herramientas (llama3.1, qwen2.5, mistral-nemo...).
AI_MODEL=llama3.1
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.3
# Maximo de caracteres del documento que se envian al modelo (IA Studio).
AI_STUDIO_MAX_CHARS=12000

# --- IA con vision (analizar fotos) y control de la app ---
# Modelo de vision para fotos (pizarra, examenes...). Descargar con
# `ollama pull llava` (o moondream, llama3.2-vision, etc.).
AI_VISION_MODEL=llava
# Tamano maximo de imagen que se envia al modelo de vision (MB).
AI_MAX_IMAGE_MB=8
# Permite a la IA crear/editar elementos y pedir confirmacion para borrar.
AI_TOOLS_ENABLED=true
AI_MAX_TOOL_ITERATIONS=6

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
