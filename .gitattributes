# Normaliza finales de linea. Los scripts de shell (.sh) DEBEN tener LF para
# funcionar en la VM Linux; los .cmd/.ps1 de Windows, CRLF.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
