# URL publica del backend FastAPI.
# - En local con el proxy de Docker: dejalo vacio o http://localhost:8000
#   (el frontend usa el mismo origen cuando sirve en el puerto estandar).
# - En Vercel: la URL de Render, p. ej. https://academic-autopilot.onrender.com
#   Se incrusta en el build: si cambia, vuelve a desplegar en Vercel
#   (Settings -> Environment Variables y luego Redeploy).
NEXT_PUBLIC_API_URL=http://localhost:8000
